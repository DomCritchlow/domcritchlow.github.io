---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "{{ project.shortname }}/index.html"
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0; url={{ project.url }}">
  <link rel="canonical" href="{{ project.url }}">
  <title>{{ project.title }}</title>
  <script>window.location.replace("{{ project.url }}");</script>
</head>
<body></body>
</html>

